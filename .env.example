# Sao chép thành .env rồi thay giá trị bằng mật khẩu mạnh
# Tạo mật khẩu ngẫu nhiên: openssl rand -hex 12
DB_NAME=petshopdb
DB_ADMIN_USER=petshop_admin
DB_ADMIN_PASSWORD=change_me
APP_DB_PASSWORD=change_me
EXPORTER_DB_PASSWORD=change_me
PGADMIN_EMAIL=admin@petshop.com
PGADMIN_PASSWORD=change_me
GRAFANA_ADMIN_PASSWORD=change_me
VM_IP=192.168.211.129
# --- [MỚI] Tài khoản quản trị của WEBSITE (app tự tạo khi khởi động lần đầu) ---
ADMIN_EMAIL=admin@petshop.vn
ADMIN_PASSWORD=change_me
# --- [MỚI] Khóa ký session/cookie. Tạo bằng: openssl rand -hex 32 ---
SECRET_KEY=change_me
