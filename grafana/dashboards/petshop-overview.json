{
  "uid": "petshop-overview",
  "title": "PetShop - Tổng quan hệ thống",
  "tags": ["petshop"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Targets UP", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }, "targets": [ { "expr": "sum(up)", "refId": "A" } ] },
    { "id": 2, "type": "stat", "title": "Targets DOWN", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 }, "targets": [ { "expr": "count(up == 0) or vector(0)", "refId": "A" } ] },
    { "id": 3, "type": "stat", "title": "Số container đang chạy", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 }, "targets": [ { "expr": "count(container_last_seen{name!=\"\"})", "refId": "A" } ] },
    { "id": 4, "type": "stat", "title": "Kết nối PostgreSQL", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 }, "targets": [ { "expr": "sum(pg_stat_activity_count)", "refId": "A" } ] },

    { "id": 5, "type": "timeseries", "title": "CPU theo container (%)", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }, "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] }, "targets": [ { "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name!=\"\"}[1m])) * 100", "legendFormat": "{{name}}", "refId": "A" } ] },
    { "id": 6, "type": "timeseries", "title": "RAM theo container", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }, "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "targets": [ { "expr": "container_memory_working_set_bytes{name!=\"\"}", "legendFormat": "{{name}}", "refId": "A" } ] },

    { "id": 7, "type": "timeseries", "title": "Nginx - số request/giây", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [ { "expr": "rate(nginx_http_requests_total[1m])", "legendFormat": "requests/s", "refId": "A" } ] },
    { "id": 8, "type": "timeseries", "title": "Nginx - kết nối", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }, "targets": [ { "expr": "nginx_connections_active", "legendFormat": "active", "refId": "A" }, { "expr": "nginx_connections_waiting", "legendFormat": "waiting", "refId": "B" } ] },

    { "id": 9, "type": "timeseries", "title": "Flask app - request/giây theo mã trạng thái", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }, "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }, "targets": [ { "expr": "sum by (status) (rate(flask_http_request_total[1m]))", "legendFormat": "HTTP {{status}}", "refId": "A" } ] },
    { "id": 10, "type": "timeseries", "title": "PostgreSQL - kết nối theo trạng thái", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 }, "targets": [ { "expr": "sum by (state) (pg_stat_activity_count)", "legendFormat": "{{state}}", "refId": "A" } ] },

    { "id": 11, "type": "timeseries", "title": "PostgreSQL - dung lượng database", "datasource": { "type": "prometheus", "uid": "prometheus" }, "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 }, "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }, "targets": [ { "expr": "pg_database_size_bytes{datname=\"petshopdb\"}", "legendFormat": "{{datname}}", "refId": "A" } ] }
  ]
}
